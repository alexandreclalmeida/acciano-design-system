{
  "name": "acciano-design-system",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/tokens && npm run build --workspace=packages/components && npm run build --workspace=packages/icons && npm run build --workspace=packages/logos",
    "build:tokens": "npm run build --workspace=packages/tokens",
    "build:components": "npm run build --workspace=packages/components",
    "build:icons": "npm run build --workspace=packages/icons",
    "build:logos": "npm run build --workspace=packages/logos",
    "storybook": "npm run storybook --workspace=apps/storybook",
    "build:storybook": "npm run build-storybook --workspace=apps/storybook",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
